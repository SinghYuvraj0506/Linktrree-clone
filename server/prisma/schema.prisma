generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id String @id @default(uuid())

  email        String           @unique
  password     String?
  name         String
  image        String?
  provider     ACCOUNT_PROVIDER
  refreshToken String?
  status       Int              @default(1)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @default(now()) @updatedAt

  slug String @unique
  templateData Json?

  redirect_link_id  String? @unique  // DIRECTLY REDIRECT TO THIS LINK
  redirect_link  Link?  @relation("RedirectLinkRelation", fields: [redirect_link_id], references: [id])

  links Link[]
  analytics LinkClicks[]

  @@map("users")
}

model Link {
  id    String @id @default(cuid())
  title String
  url   String
  order Int

  type LINKS_TYPE
  active  Boolean  @default(true)

  thumbnail   String?
  thumbnail_layout  THUMBNAIL_LAYOUT_TYPE @default(COMPACT)

  prioritize  Boolean  @default(false)
  animation_type LINK_ANIMATION_TYPE @default(NONE)

  show_time  DateTime?
  hide_time  DateTime?

  isLocked  Boolean @default(false)
  lock_type LINK_LOCK_TYPE @default(NONE)
  lock_data Json?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  redirect_relation_user_id String?
  redirect_relation_user User? @relation("RedirectLinkRelation")

  analytics LinkClicks[]

  @@map("links")
}

model LinkClicks {
  id    String @id @default(cuid())

  ip    String?
  country String?
  region  String?
  timezone  String?
  city  String?
  ll  Float[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  linkId  String?
  link    Link? @relation(fields: [linkId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("linksClicks")
}

enum ACCOUNT_PROVIDER {
  GOOGLE
  CREDENTIALS
}

enum LINKS_TYPE {
  SOCIAL
  OTHERS
}

enum THUMBNAIL_LAYOUT_TYPE {
  COMPACT
  LARGE
}

enum LINK_ANIMATION_TYPE {
  NONE
  BUZZ
  WOBBLE
  POP
  SWIPE
}

enum LINK_LOCK_TYPE {
  NONE
  SUBSCRIBE
  CODE
  SENSITIVE
  DOB
}
